# ═══════════════════════════════════════════════════════════════
# KEURFLOW — Environment variables template
# Copy to .env.local (web) / .env (mobile via EAS secrets) and fill in.
# NEVER commit a file with real values. See README.md § Sécurité.
# ═══════════════════════════════════════════════════════════════

# ── Supabase (public — safe to expose to the browser/app bundle) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (SERVER ONLY — never prefix with NEXT_PUBLIC_/EXPO_PUBLIC_) ──
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── App ──
NEXT_PUBLIC_APP_URL=
# Mobile's own copy — lets the Abonnement screen deep-link out to web's
# billing page. Falls back to the production URL in code when unset.
EXPO_PUBLIC_WEB_URL=

# ── Payments (SERVER ONLY) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID_INDIVIDUAL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── AI / OCR — Phase future (SERVER ONLY) ──
OPENAI_API_KEY=

# ── Email (SERVER ONLY) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
